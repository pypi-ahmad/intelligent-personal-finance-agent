# Copy to .env and fill in the keys you use.

# OpenAI-compatible (also used if you set a custom gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Agnes AI — model is fixed to agnes-2.5-flash
AGNES_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Optional Ollama host (default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
