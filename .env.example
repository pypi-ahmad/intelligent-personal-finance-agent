# Template only. Copy to .env on a new machine if you do not set OS env vars.
# This app reads process/user environment first and does not override it.

# OpenAI — models: gpt-5.6-luna (medium effort)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Agnes AI — model: agnes-2.5-flash
# Docs: https://www.agnes-ai.com/en/docs/agnes-25-flash
# Base URL is fixed: https://apihub.agnes-ai.com/v1
AGNES_API_KEY=

# Google Gemini — models: gemini-3.5-flash-lite, gemini-3.7-flash
GOOGLE_API_KEY=

# Optional Ollama host (default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
